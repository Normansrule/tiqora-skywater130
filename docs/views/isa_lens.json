{
 "about": "A reading aid for people who know x86: each RV32E instruction Tiqora decodes beside the closest x86-64 instruction. Written by hand; both columns are assembled by real assemblers (docs/tools/views_isa.py) and the RISC-V opcode of every row is checked against the core's decoder. Registers are paired a0=eax, a1=esi, a2=edx, sp=rsp, ra=the return address x86 keeps on the stack. Tiqora runs only the RISC-V column: it has no x86 decoder.",
 "rows": [
  {"opc": "OPC_LUI",    "rv": "lui a0, 0x12345",      "x86": "mov eax, 0x12345000",                 "note": "load a 20-bit constant into the top of a register"},
  {"opc": "OPC_AUIPC",  "rv": "auipc a0, 1",          "x86": "lea rax, [rip+0x1000]",               "note": "PC-relative address; x86-64 counts from the next instruction, RISC-V from this one"},
  {"opc": "OPC_JAL",    "rv": "jal ra, .+16",         "x86": "call .+16",                           "note": "call: RISC-V keeps the return address in ra, x86 pushes it"},
  {"opc": "OPC_JALR",   "rv": "jalr zero, 0(ra)",     "x86": "ret",                                 "note": "return"},
  {"opc": "OPC_BRANCH", "rv": "beq a0, a1, .+8",      "x86": "cmp eax, esi\nje .+8",                "note": "RISC-V compares and branches in one instruction; x86 sets flags first"},
  {"opc": "OPC_BRANCH", "rv": "blt a0, a1, .+8",      "x86": "cmp eax, esi\njl .+8",                "note": "signed less-than"},
  {"opc": "OPC_BRANCH", "rv": "bltu a0, a1, .+8",     "x86": "cmp eax, esi\njb .+8",                "note": "unsigned less-than"},
  {"opc": "OPC_LOAD",   "rv": "lw a0, 8(sp)",         "x86": "mov eax, dword ptr [rsp+8]",          "note": "load a word"},
  {"opc": "OPC_LOAD",   "rv": "lb a0, 1(sp)",         "x86": "movsx eax, byte ptr [rsp+1]",         "note": "load a byte, sign-extended"},
  {"opc": "OPC_LOAD",   "rv": "lbu a0, 1(sp)",        "x86": "movzx eax, byte ptr [rsp+1]",         "note": "load a byte, zero-extended"},
  {"opc": "OPC_STORE",  "rv": "sw a0, 8(sp)",         "x86": "mov dword ptr [rsp+8], eax",          "note": "store a word"},
  {"opc": "OPC_STORE",  "rv": "sb a0, 1(sp)",         "x86": "mov byte ptr [rsp+1], al",            "note": "store a byte"},
  {"opc": "OPC_OPIMM",  "rv": "addi a0, a0, 5",       "x86": "add eax, 5",                          "note": "add a constant; x86 also sets flags, RISC-V has none"},
  {"opc": "OPC_OPIMM",  "rv": "slli a0, a0, 3",       "x86": "shl eax, 3",                          "note": "shift left"},
  {"opc": "OPC_OPIMM",  "rv": "srai a0, a0, 3",       "x86": "sar eax, 3",                          "note": "arithmetic shift right"},
  {"opc": "OPC_OPIMM",  "rv": "andi a0, a0, 255",     "x86": "and eax, 255",                        "note": "bitwise and with a constant"},
  {"opc": "OPC_OP",     "rv": "add a0, a0, a1",       "x86": "add eax, esi",                        "note": "RISC-V has three operands; x86 overwrites the first"},
  {"opc": "OPC_OP",     "rv": "sub a0, a0, a1",       "x86": "sub eax, esi",                        "note": "subtract"},
  {"opc": "OPC_OP",     "rv": "slt a0, a1, a2",       "x86": "cmp esi, edx\nsetl al\nmovzx eax, al", "note": "set if less than: one RISC-V instruction, three x86"},
  {"opc": "OPC_OP",     "rv": "xor a0, a0, a1",       "x86": "xor eax, esi",                        "note": "exclusive or"},
  {"opc": "OPC_FENCE",  "rv": "fence",                "x86": "mfence",                              "note": "order memory accesses"},
  {"opc": "OPC_SYSTEM", "rv": "ecall",                "x86": "syscall",                             "note": "call the environment; on Tiqora it halts the core"},
  {"opc": "OPC_SYSTEM", "rv": "ebreak",               "x86": "int3",                                "note": "breakpoint"},
  {"opc": "OPC_CUSTOM0", "rv": ".insn r 0x0b, 3, 0, zero, a0, zero", "x86": "1: rdtsc\ncmp eax, esi\njb 1b", "note": "Xpulse TWAIT a0: sleep until the timebase reaches a0. No x86 instruction does this; the nearest is a loop on the time-stamp counter"},
  {"opc": "OPC_CUSTOM0", "rv": ".insn r 0x0b, 4, 0, zero, a0, a1", "x86": "mov dword ptr [rdi], eax", "note": "Xpulse TARM a0, a1: arm trigger a1 for time a0 in hardware; on x86 this would be a store to a timer peripheral's register, if the board had one"}
 ]
}
