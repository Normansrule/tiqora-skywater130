{
 "captions": [
  {
   "at": 1222,
   "blocks": [
    "tp_ncore"
   ],
   "text": "The word 0x00000000 arrives. No RV32E or Xpulse instruction has opcode 0, so the core runs one pass without writing anything, latches ILLEGAL and moves on."
  },
  {
   "at": 1236,
   "blocks": [
    "tp_ncore",
    "tp_soc"
   ],
   "text": "ILLEGAL (uo_out[6]) is high and stays high until reset. Execution continues with the next instruction."
  },
  {
   "at": 1247,
   "blocks": [
    "sync_capture",
    "sync_unit"
   ],
   "text": "ui_in[0] rises. Two synchronizer flip-flops later the edge is an event, stamped with the timebase."
  },
  {
   "at": 1251,
   "blocks": [
    "sync_capture",
    "sync_event_fifo"
   ],
   "text": "ui_in[1] rises 4 clocks later: the second event, stamped exactly 4 ticks after the first."
  },
  {
   "at": 1255,
   "blocks": [
    "sync_event_fifo"
   ],
   "text": "ui_in[2] rises, but the queue is already full (2 of 2). This event is lost."
  },
  {
   "at": 1258,
   "blocks": [
    "sync_event_fifo",
    "tp_soc"
   ],
   "text": "OVF (uo_out[3]) goes high and stays high: software can tell an event was dropped."
  },
  {
   "at": 1380,
   "blocks": [
    "sync_unit",
    "sync_event_fifo"
   ],
   "text": "tpop x2: pin channel 0, rising, timestamp 1253."
  },
  {
   "at": 1412,
   "blocks": [
    "sync_unit",
    "sync_event_fifo"
   ],
   "text": "tpop x3: pin channel 1, rising, timestamp 1257."
  },
  {
   "at": 1444,
   "blocks": [
    "sync_unit",
    "sync_event_fifo"
   ],
   "text": "tpop x4: empty (0)."
  },
  {
   "at": 1508,
   "blocks": [
    "tp_ncore"
   ],
   "text": "ecall: the core halts and raises HALT (uo_out[5])."
  }
 ],
