{
 "captions": [
  {
   "at": -4,
   "blocks": [
    "tt_um_normansrule_tiqora",
    "tp_soc"
   ],
   "text": "Reset held: rst_n is low, every uio pin is an input (uio_oe = 0x00), so the demo board could program the flash now. ui_in[2:0] are being latched as the QSPI read latency (0 here)."
  },
  {
   "at": -4,
   "blocks": [
    "qspi_ctrl"
   ],
   "text": "Reset released. qspi_ctrl starts its wake-up sequence before the core may fetch anything: neither memory understands four-bit transactions yet. Step 1 of 6 starts at once: flash: all four lines high, 8 clocks (leave continuous read)."
  },
  {
   "at": 16,
   "blocks": [
    "qspi_ctrl"
   ],
   "text": "Wake-up step 2 of 6, flash: command 0xEB, one bit per clock (Fast Read Quad I/O)."
  },
  {
   "at": 33,
   "blocks": [
    "qspi_ctrl"
   ],
   "text": "Wake-up step 3 of 6, flash: address 0 and mode 0xA0, four bits per clock (stay in continuous read)."
  },
  {
   "at": 50,
   "blocks": [
    "qspi_ctrl"
   ],
   "text": "Wake-up step 4 of 6, flash: 4 dummy clocks and one byte, then chip select high."
  },
  {
   "at": 66,
   "blocks": [
    "qspi_ctrl"
   ],
   "text": "Wake-up step 5 of 6, both RAMs: 0xF5, four bits per clock (leave QPI if a previous run left it on)."
  },
  {
   "at": 74,
   "blocks": [
    "qspi_ctrl"
   ],
   "text": "Wake-up step 6 of 6, both RAMs: 0x35, one bit per clock (enter QPI)."
  },
  {
   "at": 94,
   "blocks": [
    "qspi_ctrl",
    "tp_bus"
   ],
   "text": "Both memories awake: the testbench counts 99 clocks from reset release (1.98 us at 50 MHz). The flash is in continuous read and the RAMs in QPI mode; the core's first fetch goes out."
  },
  {
   "at": 138,
   "blocks": [
    "tp_ncore"
   ],
   "text": "Cycle 138: the first instruction word arrives (imem_rvalid). The program starts at flash address 0."
  }
 ],
