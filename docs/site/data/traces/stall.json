{
 "captions": [
  {
   "at": 1521,
   "blocks": [
    "tp_ncore"
   ],
   "text": "A second program, run from reset: lui x1, 0x50000 then lw x2, 0(x1). Device 5 does not exist on this chip."
  },
  {
   "at": 1697,
   "blocks": [
    "tp_ncore",
    "tp_bus"
   ],
   "text": "The load enters MEM with dmem_addr = 0x50000000. tp_bus decodes devices 0 to 4 only, so nothing will ever answer."
  },
  {
   "at": 2097,
   "blocks": [
    "tp_bus"
   ],
   "text": "Still in MEM 400 clocks later. No HALT, no ILLEGAL: from the pins this looks like a chip that stopped. There is no bus timeout or bus-error trap in this design."
  },
  {
   "at": 3021,
   "blocks": [
    "tp_ncore",
    "qspi_ctrl"
   ],
   "text": "Reset is the only way out: the core returns to FETCH and the memory wake-up starts again."
  }
 ],
