{
 "captions": [
  {
   "at": 297,
   "blocks": [
    "tp_periph",
    "tp_uart"
   ],
   "text": "sw x14, 0x0c(x5) writes 'K' (0x4B) to UART_DATA. The timing tour set UART_DIV to 8 clocks per bit so the frame fits on screen; the reset value is 434."
  },
  {
   "at": 309,
   "blocks": [
    "tp_uart"
   ],
   "text": "uo_out[4] drops: the start bit. Then 8 data bits, least significant first: 1,1,0,1,0,0,1,0 for 0x4B, and a high stop bit. The core does not wait for it."
  },
  {
   "at": 340,
   "blocks": [
    "sync_unit",
    "sync_timebase"
   ],
   "text": "TIME x1 reads the timebase in its XP clock: 344. No bus access: the timing unit answers in the same clock."
  },
  {
   "at": 375,
   "blocks": [
    "sync_compare"
   ],
   "text": "tarm x1, x0 arms TRIG0 for tick 544 (the TIME value + 200)."
  },
  {
   "at": 405,
   "blocks": [
    "tp_ncore"
   ],
   "text": "twait x1: the deadline has not come, so the core parks in TWAIT. Nothing is fetched; the trigger needs no software."
  },
  {
   "at": 540,
   "blocks": [
    "sync_compare",
    "tp_soc"
   ],
   "text": "Tick 544: TRIG0 rises at the pin on exactly the deadline tick. The comparator fires one tick early because its output is registered, which puts the pin edge on the programmed tick."
  },
  {
   "at": 541,
   "blocks": [
    "tp_ncore"
   ],
   "text": "The core leaves TWAIT 1 clock after the deadline and fetches the next instruction."
  },
  {
   "at": 548,
   "blocks": [
    "tp_ncore",
    "tp_nregfile"
   ],
   "text": "The next instruction starts its pass 8 clocks after the deadline: inside the 10 to 17 clocks that make latency measures over all eight rotation phases. The pin was exact; software resumes inside a window."
  }
 ],
