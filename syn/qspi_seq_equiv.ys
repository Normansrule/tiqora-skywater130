# qspi_seq_equiv.ys — prove qspi_ctrl's stream position change is exact.
# syn/qspi_seq_ref.sv is qspi_ctrl before the change (module renamed qspi_ctrl_ref): it
# registered next_seq_addr = addr + 4; the new file registers seq_last = addr and adds 4
# after the register. equiv_make pairs every output and same-named wire, next_seq_addr
# included; equiv_simple and equiv_induct prove each pair equal at every clock.
# yosys -s syn/qspi_seq_equiv.ys exits non-zero if any pair is unproven.
read_verilog -sv src/bus/qspi_ctrl.sv
read_verilog -sv syn/qspi_seq_ref.sv
hierarchy -check
proc; flatten; memory; opt_clean
equiv_make qspi_ctrl_ref qspi_ctrl equiv
hierarchy -top equiv
equiv_simple -seq 2
equiv_induct -seq 2
equiv_status -assert
